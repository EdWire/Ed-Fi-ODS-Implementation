<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://ed-fi.org/5.2.0" xmlns:ann="http://ed-fi.org/annotation" targetNamespace="http://ed-fi.org/5.2.0" elementFormDefault="qualified" attributeFormDefault="unqualified">
  <xs:include schemaLocation="Ed-Fi-Core.xsd" />
  <xs:annotation>
    <xs:documentation>===== Ed-Fi 5.2.0 Extensions =====</xs:documentation>
  </xs:annotation>
  <xs:annotation>
    <xs:documentation>===== Domain Entities =====</xs:documentation>
  </xs:annotation>
  <xs:complexType name="EXTENSION-CalendarDateExtension">
    <xs:annotation>
      <xs:documentation></xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Domain Entity</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="CalendarDate">
        <xs:sequence>
          <xs:element name="InstructionalDuration" type="EventDuration">
            <xs:annotation>
              <xs:documentation>The portion of the day that instruction occurred.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-DisciplineActionExtension">
    <xs:annotation>
      <xs:documentation></xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Domain Entity</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="DisciplineAction">
        <xs:sequence>
          <xs:element name="UnilateralRemoval" type="EXTENSION-UnilateralRemovalDescriptorReferenceType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>For SPED students only who were were subject to Uniliteral Removal</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>EXTENSION-UnilateralRemovalDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
          <xs:element name="GFSAExpulsionModifiedToLessThanOneYear" type="xs:boolean" minOccurs="0">
            <xs:annotation>
              <xs:documentation>True = Student expelled under GFSA had expulsion modified to less than one year.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-DisciplineIncidentExtension">
    <xs:annotation>
      <xs:documentation></xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Domain Entity</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="DisciplineIncident">
        <xs:sequence>
          <xs:element name="HomicideIndicator" type="xs:boolean" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Indicates if this discipline incident involved homicide.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="ShootingIndicator" type="xs:boolean" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Indicates if the discipline incident involved a shooting.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-EmergencyExclusion">
    <xs:annotation>
      <xs:documentation>Captures emergency exclusion details when a student is temporarily removed from school due to health, safety, or educational disruption concerns.</xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Domain Entity</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="ComplexObjectType">
        <xs:sequence>
          <xs:element name="StudentReference" type="StudentReferenceType">
            <xs:annotation>
              <xs:documentation>The student who was subject to the emergency exclusion.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="EducationOrganizationReference" type="EducationOrganizationReferenceType">
            <xs:annotation>
              <xs:documentation>The education organization (school or district) that implemented the emergency exclusion.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="ExclusionDate" type="xs:date">
            <xs:annotation>
              <xs:documentation>The date the emergency exclusion began.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="ExclusionDuration" type="EXTENSION-ExclusionDuration">
            <xs:annotation>
              <xs:documentation>The duration of the emergency exclusion in days.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="EmergencyExclusionReason" type="EXTENSION-EmergencyExclusionReasonDescriptorReferenceType">
            <xs:annotation>
              <xs:documentation>The reason for the emergency exclusion (Health, Safety of Themselves or Others, Disruption to Education).</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>EXTENSION-EmergencyExclusionReasonDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-IdeaEvent">
    <xs:annotation>
      <xs:documentation>An IDEA related student event describing status, dates and narrative.</xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Domain Entity</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="ComplexObjectType">
        <xs:sequence>
          <xs:element name="StudentReference" type="StudentReferenceType">
            <xs:annotation>
              <xs:documentation>A reference to the student.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="IDEAEventID" type="EXTENSION-IDEAEventID">
            <xs:annotation>
              <xs:documentation>A unique identifier for the event record as assigned by the provider of IEP services.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="EducationOrganizationReference" type="EducationOrganizationReferenceType">
            <xs:annotation>
              <xs:documentation>The identifier assigned to the education organization (usually District/LEA) providing IDEA Services.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="IDEAEvent" type="EXTENSION-IDEAEventDescriptorReferenceType">
            <xs:annotation>
              <xs:documentation>The IDEA event recorded for the student.</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>EXTENSION-IDEAEventDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
          <xs:element name="BeginDate" type="xs:date">
            <xs:annotation>
              <xs:documentation>The date when the IDEA related event started.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="EndDate" type="xs:date">
            <xs:annotation>
              <xs:documentation>The date when the IDEA event concluded.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="EventReason" type="EXTENSION-EventReasonDescriptorReferenceType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>The reason why the IDEA event occured.</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>EXTENSION-EventReasonDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
          <xs:element name="EventCompliance" type="EXTENSION-EventComplianceDescriptorReferenceType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>The type of compliance represented by this event.</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>EXTENSION-EventComplianceDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
          <xs:element name="EventNarrative" type="EXTENSION-EventNarrative" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Detailed and summary notes recorded during the event.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-PostGraduateActivity">
    <xs:annotation>
      <xs:documentation>NDE new Domain for capturing the CTE post graduation activity details. The Post School Survey template is provided for all 12th grade Career Education Concentrators identified as a [School-Year] completer with diploma and is submitted ONE-YEAR AFTER high school graduation.</xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Domain Entity</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="ComplexObjectType">
        <xs:sequence>
          <xs:element name="StudentReference" type="StudentReferenceType">
            <xs:annotation>
              <xs:documentation>The NDE student identifier (10-digit) for the CTE Post graduate student. This cannot be a student reference since the Post Graduate Activity is reported one year after student's graduation and student will not be in current year student list.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="SchoolYear" type="SchoolYearType">
            <xs:annotation>
              <xs:documentation>Represents the school year during which the student graduated.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="LocalEducationAgencyReference" type="LocalEducationAgencyReferenceType">
            <xs:annotation>
              <xs:documentation>The number assigned to your school district/system by NDE.  The district that submitted the graduation record for the CTE Student graduate.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="PostGraduateActivity" type="EXTENSION-PostGraduateActivityDescriptorReferenceType">
            <xs:annotation>
              <xs:documentation>Appropriate code to describe the student's activity after completion.</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>EXTENSION-PostGraduateActivityDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
          <xs:element name="PostGraduateActivityDetermination" type="EXTENSION-PostGraduateActivityDeterminationDescriptorReferenceType">
            <xs:annotation>
              <xs:documentation>Appropriate code to describe the student's activity after completion.</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>EXTENSION-PostGraduateActivityDeterminationDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-SectionExtension">
    <xs:annotation>
      <xs:documentation></xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Domain Entity</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="Section">
        <xs:sequence>
          <xs:element name="CourseStaffIdOverride" type="EXTENSION-CourseStaffIdOverride" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Staff Id of non district employee correspoinding to the teacher of the course.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="SectionDelivery" type="EXTENSION-SectionDeliveryDescriptorReferenceType" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
              <xs:documentation>Description of the delivery method for a section of a course.</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>EXTENSION-SectionDeliveryDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:annotation>
    <xs:documentation>===== Descriptors =====</xs:documentation>
  </xs:annotation>
  <xs:complexType name="EXTENSION-EarlyLearningSettingDescriptor">
    <xs:annotation>
      <xs:documentation>To indicate the classroom setting of the student's program participation.</xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Descriptor</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="DescriptorType" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-EmergencyExclusionReasonDescriptor">
    <xs:annotation>
      <xs:documentation>Description that best reflects the reason for a student's exclusion.</xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Descriptor</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="DescriptorType" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-EventComplianceDescriptor">
    <xs:annotation>
      <xs:documentation>The policy or law for which an event is compliant.</xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Descriptor</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="DescriptorType" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-EventReasonDescriptor">
    <xs:annotation>
      <xs:documentation>Reason the event occured.</xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Descriptor</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="DescriptorType" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-IDEAEventDescriptor">
    <xs:annotation>
      <xs:documentation>IDEA event type. Examples: Referral for Evaluation, IEP Approved, Parental COnsent Given, Evaluation Complete.</xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Descriptor</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="DescriptorType" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-ImmigrantIndicatorDescriptor">
    <xs:annotation>
      <xs:documentation>Description that best reflects the student's immigrant status.</xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Descriptor</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="DescriptorType" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-PartCTransitionDelayReasonDescriptor">
    <xs:annotation>
      <xs:documentation>The reason the Part C IDEA child was delayed in transitioning to Part B.</xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Descriptor</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="DescriptorType" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-PlacementTypeDescriptor">
    <xs:annotation>
      <xs:documentation>Indicates placement type of the student.</xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Descriptor</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="DescriptorType" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-PositionTitleDescriptor">
    <xs:annotation>
      <xs:documentation>Description of the default position titles for the dashboard claimset mapping.</xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Descriptor</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="DescriptorType" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-PostGraduateActivityDescriptor">
    <xs:annotation>
      <xs:documentation>Description of the student�s activity after completion.</xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Descriptor</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="DescriptorType" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-PostGraduateActivityDeterminationDescriptor">
    <xs:annotation>
      <xs:documentation>Description of the method of determining the Post Graduate Activity Code value for the student.</xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Descriptor</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="DescriptorType" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-SectionDeliveryDescriptor">
    <xs:annotation>
      <xs:documentation>Description of the delivery method for a section of a course.</xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Descriptor</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="DescriptorType" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-SpecialEducationProgramDescriptor">
    <xs:annotation>
      <xs:documentation>Type of program a Special Education student is in - Part B or Part C.</xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Descriptor</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="DescriptorType" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-UnilateralRemovalDescriptor">
    <xs:annotation>
      <xs:documentation>Description of the unilateral removal type for a special education student.</xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Descriptor</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="DescriptorType" />
    </xs:complexContent>
  </xs:complexType>
  <xs:annotation>
    <xs:documentation>===== Associations =====</xs:documentation>
  </xs:annotation>
  <xs:complexType name="EXTENSION-StudentDisciplineIncidentBehaviorAssociationExtension">
    <xs:annotation>
      <xs:documentation></xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Association</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="StudentDisciplineIncidentBehaviorAssociation">
        <xs:sequence>
          <xs:element name="GunFreeSchoolViolation" type="xs:boolean" minOccurs="0">
            <xs:annotation>
              <xs:documentation>True = Student was charged with a Gun-Free Schools Violation.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="SchoolRelatedArrestIndicator" type="xs:boolean" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Indicates if student was involved in a disciplinary incident that resulted in an arrest.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="ReferralToLawEnforcement" type="xs:boolean" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Indicates if a student was referred to law enforcement.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="SeriousBodilyInjury" type="xs:boolean" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Indicates if an incident resulted in serious bodily injury as defined by 18 U.S.C. Section 1365(3)(h).</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-StudentEarlyLearningProgramAssociation">
    <xs:annotation>
      <xs:documentation>NDE specific StudentEarlyLearningProgramAssociation.</xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Association</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="GeneralStudentProgramAssociation">
        <xs:sequence>
          <xs:element name="EarlyLearningSetting" type="EXTENSION-EarlyLearningSettingDescriptorReferenceType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Indicates the classroom setting of the student's program participation.</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>EXTENSION-EarlyLearningSettingDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-StudentEducationOrganizationAssociationExtension">
    <xs:annotation>
      <xs:documentation></xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Association</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="StudentEducationOrganizationAssociation">
        <xs:sequence>
          <xs:element name="ImmigrantIndicator" type="EXTENSION-ImmigrantIndicatorDescriptorReferenceType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Description that best reflects the student's immigrant status.</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>EXTENSION-ImmigrantIndicatorDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-StudentLanguageInstructionProgramAssociationExtension">
    <xs:annotation>
      <xs:documentation></xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Association</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="StudentLanguageInstructionProgramAssociation">
        <xs:sequence>
          <xs:element name="RedesignatedEnglishFluent" type="xs:boolean" minOccurs="0">
            <xs:annotation>
              <xs:documentation>students that have been redesignated as English Fluent.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="TestedProficientOnScreener" type="xs:boolean" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Indicates whether the student was tested on a language proficiency screener and demonstrated fluency on that initial screening assessment.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-StudentSchoolAssociationExtension">
    <xs:annotation>
      <xs:documentation></xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Association</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="StudentSchoolAssociation">
        <xs:sequence>
          <xs:element name="StudentDaysEnrolled" type="EXTENSION-StudentDaysEnrolled" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Override field to determine number of days the student was in membership for ADA and ADM calculation.  This field is optional, and records without a value will use the related calendar to determine days enrolled.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="ResidentLocalEducationAgencyReference" type="LocalEducationAgencyReferenceType">
            <xs:annotation>
              <xs:documentation>District where student resides. If student resides out of state, use district of enrollment.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="ResidentSchoolReference" type="SchoolReferenceType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>School within a district where student resides. If student resides out of state, use school of enrollment or leave blank.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="ReportingSchoolReference" type="SchoolReferenceType">
            <xs:annotation>
              <xs:documentation>School within a district where student's records should be reported for state reporting purposes.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="EXTENSION-StudentSpecialEducationProgramAssociationExtension">
    <xs:annotation>
      <xs:documentation></xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Association</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="StudentSpecialEducationProgramAssociation">
        <xs:sequence>
          <xs:element name="SpecialEducationProgram" type="EXTENSION-SpecialEducationProgramDescriptorReferenceType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Type of program a Special Education student is in - Part B or Part C.</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>EXTENSION-SpecialEducationProgramDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
          <xs:element name="PlacementType" type="EXTENSION-PlacementTypeDescriptorReferenceType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Placement type of the student.</xs:documentation>
              <xs:appinfo>
                <ann:Descriptor>EXTENSION-PlacementTypeDescriptor</ann:Descriptor>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
          <xs:element name="ToTakeAlternateAssessment" type="xs:boolean" minOccurs="0">
            <xs:annotation>
              <xs:documentation>True = Indicates the student needs alternate assessment.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="InitialSpecialEducationEntryDate" type="xs:date" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Date when the child's first IEP or IFSP</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:annotation>
    <xs:documentation>===== Extended Reference Types =====</xs:documentation>
  </xs:annotation>
  <xs:complexType name="EXTENSION-EmergencyExclusionIdentityType">
    <xs:annotation>
      <xs:documentation>Identity of an EmergencyExclusion.</xs:documentation>
      <xs:appinfo>
        <ann:TypeGroup>Identity</ann:TypeGroup>
      </xs:appinfo>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="StudentReference" type="StudentReferenceType">
        <xs:annotation>
          <xs:documentation>The student who was subject to the emergency exclusion.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="EducationOrganizationReference" type="EducationOrganizationReferenceType">
        <xs:annotation>
          <xs:documentation>The education organization (school or district) that implemented the emergency exclusion.</xs:documentation>
        </xs:annotation>
      </xs:element>
